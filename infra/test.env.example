# =========================================================================
# Environment override for the "test" GCP deployment.
#
# provision.sh and deploy.sh read config through lib.sh's env_get(), which
# checks THIS file first and falls back to the repo root's .env for
# anything not listed here. That split matters: the root .env is tuned for
# local development (DJANGO_DEBUG=true, SQLite, dev-friendly cookies) and
# none of that belongs on a deployment reachable from the internet, even a
# "test" one - only put overrides here, not a full copy of .env.
#
# Copy to infra/test.env and fill in. infra/test.env is gitignored.
#   cp infra/test.env.example infra/test.env
#
# Whatever you do NOT set here is inherited from the root .env as-is - for
# example M360_ENABLED / TEXTBEE_ENABLED are deliberately not overridden:
# whether SMS actually sends is a decision for the environment as a whole,
# not something that should silently differ between local and cloud.
# =========================================================================

# The one override that actually matters: local dev runs with DEBUG=true,
# which leaks stack traces and settings to anyone who can reach the URL.
# Cloud Run's plain_env_vars pass-through in deploy.sh will ship whatever
# this resolves to - without this line, a cloud "test" deploy would inherit
# the root .env's DJANGO_DEBUG=true.
DJANGO_DEBUG=false

# Uncomment to give the cloud test environment its own Safety Officer
# password rather than inheriting the local dev one:
# DJANGO_SUPERUSER_PASSWORD=

# Uncomment to keep the cloud test environment from sending real email
# while you are still exercising the infrastructure itself:
# EMAIL_ENABLED=false

# Uncomment to give this environment its own Django secret key rather than
# reusing the local dev one (provision.sh writes whichever value resolves
# here into Secret Manager):
# DJANGO_SECRET_KEY=
