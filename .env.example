# =========================================================================
# Web-based Automated Call Tree System - environment template
#
# Copy to .env and fill in. .env is gitignored; never commit real secrets.
#   cp .env.example .env
#
# The defaults below run the whole system locally with every external
# gateway simulated: no GCP project, no SMS credits, no SMTP account.
# =========================================================================

# --- Django core ---------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-before-you-deploy
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Required on Cloud Run / any HTTPS host, comma separated, scheme included:
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Asia/Manila
DJANGO_LOG_LEVEL=INFO
# Set false only if you terminate TLS yourself and know why:
DJANGO_SECURE_COOKIES=true
# Redirect http->https in production. Off only if a proxy already does it.
DJANGO_SSL_REDIRECT=true

# --- Database ------------------------------------------------------------
# Leave blank for SQLite at data/calltree.sqlite3 (development only).
# Docker Compose sets this to the bundled Postgres automatically.
# Cloud SQL example:
#   postgres://user:pass@/dbname?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# --- Public URL ----------------------------------------------------------
# Used to build each employee's one-tap status link. Must be reachable from
# a phone on mobile data, so localhost will not do in a real drill.
PUBLIC_BASE_URL=http://localhost:8000

# --- Google Cloud Platform ----------------------------------------------
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Firestore mirrors live safety status for real-time dashboards.
# Off means relational-only, which is fully functional.
FIRESTORE_ENABLED=false
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION_PREFIX=calltree

# Pub/Sub decouples the broadcast from the web request.
# Off means the local thread-pool dispatcher sends instead.
PUBSUB_ENABLED=false
PUBSUB_TOPIC_NOTIFICATIONS=calltree-notifications
# Shared secret for the push subscription endpoint (/api/webhooks/pubsub/).
PUBSUB_PUSH_TOKEN=
DISPATCH_FALLBACK_THREADS=4

# --- SMS gateway selection ------------------------------------------------
# Which provider below is actually used to send. Each provider still
# simulates delivery when its own *_ENABLED is off, regardless of this.
SMS_PROVIDER=m360
SMS_MAX_LENGTH=320

# --- M360 SMS gateway ----------------------------------------------------
# Off means SMS is simulated and logged instead of sent. Turn on only with
# real credentials: every message then costs credits.
M360_ENABLED=false
M360_APP_KEY=
M360_APP_SECRET=
M360_SHORTCODE_MASK=
M360_BROADCAST_URL=https://api.m360.com.ph/v3/api/broadcast
M360_BALANCE_URL=https://api.m360.com.ph/v3/api/balance
M360_TIMEOUT=15
# Shared secret for the inbound-SMS callback (/api/webhooks/m360/).
# Set this before going live: without it the endpoint is open.
M360_WEBHOOK_TOKEN=

# --- TextBee SMS gateway (textbee.dev) ------------------------------------
# TextBee sends through a paired Android phone's own SIM. Off means SMS is
# simulated and logged instead of sent.
TEXTBEE_ENABLED=false
TEXTBEE_API_KEY=
# Device id shown in the TextBee dashboard for the paired phone:
TEXTBEE_DEVICE_ID=
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
TEXTBEE_TIMEOUT=15
# Shared secret for the inbound-SMS callback (/api/webhooks/textbee/).
# TextBee's webhook config has no way to set a custom header, so if you set
# this, put it in the callback URL instead: .../api/webhooks/textbee/?token=...
# Leave blank to accept the callback with no credential at all.
TEXTBEE_WEBHOOK_TOKEN=

# --- Email (SMTP backup channel) ----------------------------------------
# Off routes mail to the console backend.
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=DSO Safety Officer <noreply@example.com>

# --- USGS Earthquake Notification Service -------------------------------
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
USGS_POLL_INTERVAL_SECONDS=60
# Shared secret for the ingestion webhook (/api/webhooks/usgs/).
USGS_WEBHOOK_TOKEN=

# --- Trigger Filter defaults --------------------------------------------
# Per-location values override these.
TRIGGER_MIN_MAGNITUDE=5.0
TRIGGER_RADIUS_KM=300
# Keep false until the geofences are tuned: true means a matching USGS event
# broadcasts to real phones with no human in the loop.
AUTO_TRIGGER_ENABLED=false

# --- Drill policy defaults ----------------------------------------------
DEFAULT_RESPONSE_WINDOW_MINUTES=5
DEFAULT_REMINDER_INTERVAL_MINUTES=2
DEFAULT_MAX_REMINDERS=2

# --- Seed account (used by docker compose and manage.py seed_demo) ------
# SEED_DEMO_ENABLED recreates the demo locations/employees (update_or_create
# on fixed IDs) every time migrations run. Off by default so deleting a demo
# entry through the personnel directory actually stays deleted. The admin
# account below is always ensured/kept in sync regardless of this flag - it
# is a Django auth User, not personnel-directory data, and a fresh database
# needs some way in.
SEED_DEMO_ENABLED=false
DJANGO_SUPERUSER_USERNAME=safetyofficer
DJANGO_SUPERUSER_EMAIL=safety@example.com
DJANGO_SUPERUSER_PASSWORD=

# --- Docker Compose Postgres --------------------------------------------
POSTGRES_DB=calltree
POSTGRES_USER=calltree
POSTGRES_PASSWORD=calltree-local-dev
