# --- Secrets -------------------------------------------------------------
# .env holds real credentials. Only .env.example is tracked.
.env
.env.*
!.env.example
*-service-account.json
*credentials*.json
!package-lock.json
# Per-environment infra overrides (infra/test.env, infra/prod.env, ...).
# Only the *.env.example template is tracked.
infra/*.env
!infra/*.env.example

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.Python
build/
dist/
!frontend/dist/
.venv/
venv/
env/
ENV/

# --- Django ---------------------------------------------------------------
*.sqlite3
*.sqlite3-journal
data/
staticfiles/
media/
*.log

# --- Node / Vite ----------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
.npm/
npm-debug.log*

# --- Testing / tooling ----------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ruff_cache/
.mypy_cache/
.tox/

# --- Editors / OS ---------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
