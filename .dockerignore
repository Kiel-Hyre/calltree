frontend/node_modules/
frontend/dist/
frontend/.vite/

*.sqlite3
data/
staticfiles/
media/
*.log

tests/
pytest.ini
requirements-dev.txt
docs/
*.pdf
*.md
!README.md

.vscode/
.idea/
.DS_Store
